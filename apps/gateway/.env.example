# Gateway-only names. Keep the three credentials in the provider's secret store.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
REDIS_URL=

# Nonsecret deployment configuration.
SLACK_WORKSPACE_ID=
SLACK_ENABLED_CHANNEL_IDS=
GATEWAY_ORIGIN=https://example.invalid
FAKE_WORKER_URL=https://example.invalid/api/fake

# Set these for the prewarmed Milestone 2 Sandbox worker.
SANDBOX_WORKER_NAME=
OPENROUTER_MODEL=

# Enable after installing the public-channel resume manifest.
SLACK_THREAD_RESUME=0

# Enable the single Slack CSV input check with the Sandbox worker and files:read.
SLACK_CSV_INPUT=0

# Enable the single public HTTPS text check with the Sandbox worker.
SLACK_PUBLIC_URL_INPUT=0

# Set both only for an enrolled, clean-seeded automatic idle test worker.
SANDBOX_MANAGED_DRIVE=
SANDBOX_MANAGED_SEED=
