# Gateway-only names. Keep the three credentials in the provider's secret store.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
REDIS_URL=

# Nonsecret deployment configuration.
SLACK_WORKSPACE_ID=
SLACK_ENABLED_CHANNEL_IDS=
GATEWAY_ORIGIN=https://example.invalid
FAKE_WORKER_URL=https://example.invalid/api/fake

# Set these for the prewarmed Milestone 2 Sandbox worker.
SANDBOX_WORKER_NAME=
OPENROUTER_MODEL=

# Enable after installing the public-channel resume manifest.
SLACK_THREAD_RESUME=0

# Enable file exchange on a matching Sandbox worker with files:read and files:write.
# The seed needs Poppler for text-based PDFs.
SLACK_FILE_EXCHANGE=0

# Enable JPEG after a vision check with the selected model and exact Pi adapter.
SLACK_JPEG_INPUT=0

# Enable the standalone Slack CSV input check with the Sandbox worker and files:read.
SLACK_CSV_INPUT=0

# Enable the standalone text-based Slack PDF check with the Sandbox worker and files:read.
SLACK_PDF_INPUT=0

# Enable the standalone Slack PNG check with the Sandbox worker and files:read.
SLACK_PNG_INPUT=0

# Enable one public HTTPS text source per request with the Sandbox worker.
SLACK_PUBLIC_URL_INPUT=0

# Enable the standalone generated CSV check with the Sandbox worker and files:write.
SLACK_CSV_OUTPUT=0

# Set both only for an enrolled, clean-seeded automatic idle test worker.
SANDBOX_MANAGED_DRIVE=
SANDBOX_MANAGED_SEED=
