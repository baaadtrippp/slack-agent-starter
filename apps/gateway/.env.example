# Vercel Production secrets for the dedicated gateway project.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
REDIS_URL=

# One internal public Slack channel and the public gateway origin.
SLACK_WORKSPACE_ID=
SLACK_ENABLED_CHANNEL_IDS=
GATEWAY_ORIGIN=https://example.invalid

# Worker bootstrap output and the operator-selected OpenRouter model slug.
SANDBOX_WORKER_NAME=
SANDBOX_MANAGED_DRIVE=
SANDBOX_MANAGED_SEED=
OPENROUTER_MODEL=

SLACK_FILE_EXCHANGE=1
SLACK_PUBLIC_URL_INPUT=1

# Enable each image format after testing the chosen model with this Pi adapter.
SLACK_JPEG_INPUT=0
SLACK_PNG_INPUT=0

# Optional comma-separated internal Slack users who can stop others' runs.
SLACK_STOP_OPERATOR_IDS=
