# Gateway-only names. Keep the three credentials in the provider's secret store.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
REDIS_URL=

# Nonsecret deployment configuration.
SLACK_WORKSPACE_ID=
SLACK_ENABLED_CHANNEL_IDS=
GATEWAY_ORIGIN=https://example.invalid
FAKE_WORKER_URL=https://example.invalid/api/fake

# Set these for the prewarmed Milestone 2 Sandbox worker.
SANDBOX_WORKER_NAME=
OPENROUTER_MODEL=

# Enable after installing the public-channel resume manifest.
SLACK_THREAD_RESUME=0
