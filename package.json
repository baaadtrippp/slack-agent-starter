{
  "name": "slack-agent-starter",
  "version": "0.0.0",
  "private": true,
  "description": "Infrastructure-first starter for a Slack gateway and a separate Pi worker.",
  "license": "MIT",
  "engines": {
    "node": "26.13.0",
    "pnpm": "12.16.1"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm check:repository",
    "check:repository": "node scripts/check-repository.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "markdownlint-cli2",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.9.10",
    "vercel": "65.9.0"
  }
}
