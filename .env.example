# Inventory only: do not copy this entire file into one Vercel project.
# Gateway project; keep these three values in the provider's secret store.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
REDIS_URL=

# Gateway project; nonsecret configuration.
SLACK_WORKSPACE_ID=
SLACK_ENABLED_CHANNEL_IDS=
GATEWAY_ORIGIN=https://example.invalid
FAKE_WORKER_URL=https://example.invalid/api/fake

# Set these for the prewarmed Milestone 2 Sandbox worker.
SANDBOX_WORKER_NAME=
OPENROUTER_MODEL=

# Platform control: prefer provider-supported short-lived authentication.
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_SANDBOX_DRIVE_ID=

# Private operator environment for the Sandbox firewall only.
OPENROUTER_API_KEY=
